{
  "manifest_version": 3,
  "name": "TrueBlock for YouTube",
  "short_name": "TrueBlock YT",
  "version": "1.9.10",
  "description": "TrueBlock: adblock, sponsor skip & enhancer for YouTube. Blocks ads, skips sponsors. Private, local-first.",
  "author": "9M2PJU",
  "homepage_url": "https://hamradio.my",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "trueblock@hamradio.my",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteActivity", "websiteContent"]
      }
    },
    "gecko_android": {}
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TrueBlock for YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "alarms"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.googlesyndication.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googleadservices.com/*",
    "https://sponsor.ajayyy.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["src/content.js", "src/enhancements.js", "src/sponsorblock.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_ads",
        "enabled": true,
        "path": "rules/block_ads.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "options_page": "src/popup.html"
}
